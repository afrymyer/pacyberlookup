# PA Cyber Incident Detection Feed - Environment Configuration

# ── Database ──
DATABASE_URL=sqlite:///data/pacyberlookup.db

# ── News Sources ──
# Google News RSS (no key needed for RSS)
# GDELT API (no key needed for public API)

# ── CISA ──
# CISA feeds are public RSS, no key needed

# ── Cybersecurity News ──
# BleepingComputer, SecurityWeek, DataBreaches.net, Recorded Future
# All use public RSS feeds, no keys needed

# ── Have I Been Pwned (HIBP) ──
# Domain search requires a paid API key: https://haveibeenpwned.com/API/Key
# Public breach list works without a key
HIBP_API_KEY=

# ── AlienVault OTX ──
# Free API key from https://otx.alienvault.com/
# Public pulse search works without a key
OTX_API_KEY=

# ── Ransomware.live ──
# Public API, no key needed

# ── Shadowserver Foundation ──
# Register at https://www.shadowserver.org/ for API access
SHADOWSERVER_API_KEY=
SHADOWSERVER_API_SECRET=

# ── Social Monitoring (Tier 4 - Optional) ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pacyberlookup/1.0

# ── Microsoft Teams Webhook ──
TEAMS_WEBHOOK_URL=

# ── Email (Exchange/SMTP) ──
EMAIL_ENABLED=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── SharePoint ──
SHAREPOINT_ENABLED=false
SHAREPOINT_SITE_URL=
SHAREPOINT_LIST_NAME=PA Cyber Incidents
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=

# ── AI Summarization (Optional) ──
AI_SUMMARIZATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Polling Intervals (minutes) ──
NEWS_POLL_INTERVAL=30
CYBERNEWS_POLL_INTERVAL=30
GDELT_POLL_INTERVAL=30
CISA_POLL_INTERVAL=60
HIBP_POLL_INTERVAL=60
RANSOMWARE_LIVE_POLL_INTERVAL=30
OTX_POLL_INTERVAL=60
SHADOWSERVER_POLL_INTERVAL=60
SOCIAL_POLL_INTERVAL=30

# ── Scoring Thresholds ──
HIGH_CONFIDENCE_THRESHOLD=75
MEDIUM_CONFIDENCE_THRESHOLD=50
LOW_CONFIDENCE_THRESHOLD=25

# ── Logging ──
LOG_LEVEL=INFO
